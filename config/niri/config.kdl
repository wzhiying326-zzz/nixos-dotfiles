// 此配置文件采用 KDL 格式：https://kdl.dev
// "/-" 用于注释掉后续节点。
// 查看 Wiki 获取完整配置说明：
// https://niri-wm.github.io/niri/Configuration:-Introduction

// 环境变量
environment {
	LC_MESSAGES "zh_CN.UTF-8"
	XMODIFIERS "@im=fcitx"
}

// 鼠标光标
cursor {
    xcursor-theme "catppuccin-frappe-pink-cursors"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 10000
}

// 输入设备配置。
// 在 Wiki 中查看完整的选项列表：
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // 你可以设置 rules、model、layout、variant 和 options。
            // 更多信息请参阅 xkeyboard-config(7)。

            // 示例：
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // 如果本节留空，niri 将从 org.freedesktop.locale1 获取 xkb 设置。
            // 你可以使用 localectl set-x11-keymap 来控制这些设置。
        }

        // 开机时启用小键盘数字锁，省略此设置则禁用。
        // numlock
    }

    // 接下来的部分包含 libinput 设置。
    // 省略设置会禁用它们，或将它们保留为默认值。
    // 这里所有被注释掉的设置都是示例，并非默认值。
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 取消此行注释可使鼠标跳转到新聚焦窗口的中心位置。
    // warp-mouse-to-focus

    // 当鼠标移入窗口或显示器时自动聚焦它们。
    // 设置 max-scroll-amount="0%" 可让其仅对已完全显示在屏幕上的窗口生效。
    // focus-follows-mouse max-scroll-amount="0%"
}

// 你可以通过名称来配置显示器，
// 在 niri 实例中运行 `niri msg outputs` 可获取显示器名称。
// 笔记本内置屏幕通常称为 "eDP-1"。
// 在 Wiki 中查看更多信息：
// https://niri-wm.github.io/niri/Configuration:-Outputs
// 记得通过移除 "/-" 来取消该节点的注释！
/-output "eDP-1" {
    // 取消此行注释可禁用该输出。
    // off

    // 输出分辨率，可选地包含刷新率。
    // 格式为 "<宽度>x<高度>" 或 "<宽度>x<高度>@<刷新率>"。
    // 如果省略刷新率，niri 将为该分辨率选择最高刷新率。
    // 如果模式被完全省略或无效，niri 将自动选择一个。
    // 在 niri 实例中运行 `niri msg outputs` 可列出所有输出及其模式。
    mode "1920x1080@120.030"

    // 你可以使用整数或小数缩放，例如 1.5 表示 150% 缩放。
    scale 2

    // transform 允许将输出逆时针旋转，有效值为：
    // normal、90、180、270、flipped、flipped-90、flipped-180 和 flipped-270。
    transform "normal"

    // 输出在全局坐标系中的位置。
    // 这会影响 "focus-monitor-left" 等定向显示器操作以及光标移动。
    // 光标只能在直接相邻的输出之间移动。
    // 定位时需要考虑输出缩放和旋转：
    // 输出的尺寸以逻辑像素（即缩放后像素）为单位。
    // 例如，一个 3840×2160 的输出在 scale 2.0 下的逻辑尺寸为 1920×1080，
    // 因此要将另一个输出直接放在其右侧，需将其 x 设为 1920。
    // 如果未设置位置或位置导致重叠，输出将被自动放置。
    position x=1280 y=0
}

// 我的显示器配置

output "Virtual-1" {
	mode "1920x1200@59.885"
	scale 1.25
}

// 影响窗口定位和大小的设置。
// 在 Wiki 中查看更多信息：
// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    // 在逻辑像素中设置窗口周围的间隙。
    gaps 16

    // 切换焦点时何时居中列，可选值为：
    // - "never"：默认行为，聚焦屏幕外的列时保持在屏幕的左边缘或右边缘。
    // - "always"：被聚焦的列始终居中。
    // - "on-overflow"：聚焦列时，如果该列与上一个被聚焦的列不能同时显示，则将其居中。
    center-focused-column "never"

    // 你可以自定义 "switch-preset-column-width"（Mod+R）循环切换的列宽。
    preset-column-widths {
        // proportion 将列宽设置为输出宽度的比例，同时考虑间隙。
        // 例如，你可以在一块输出上完美地容纳四个宽度为 "proportion 0.25" 的窗口。
        // 默认预设宽度为输出宽度的 1/3、1/2 和 2/3。
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // fixed 精确设置逻辑像素的列宽。
        // fixed 1920
    }

    // 你也可以自定义 "switch-preset-window-height"（Mod+Ctrl+Shift+R）循环切换的窗口高度。
    // preset-window-heights { }

    // 你可以更改新窗口的默认宽度。
    default-column-width { proportion 0.5; }
    // 如果你将括号留空，窗口将自行决定其初始宽度。
    // default-column-width {}

    // 默认情况下，聚焦框和边框被渲染为窗口背后的纯色背景矩形。
    // 也就是说，它们会透过半透明的窗口显示出来。
    // 这是因为使用客户端装饰的窗口可能具有任意形状。
    //
    // 如果你不喜欢这种效果，可以取消下面的 `prefer-no-csd` 注释。
    // Niri 将聚焦框和边框绘制在同意省略其客户端装饰的窗口*周围*。
    //
    // 或者，你也可以使用名为 `draw-border-with-background` 的窗口规则来覆盖此行为。

    // 你可以更改聚焦框的外观。
    focus-ring {
        // 取消此行注释可禁用聚焦框。
        // off

        // 聚焦框从窗口向外延伸的逻辑像素数。
        width 3

        // 颜色可以通过多种方式设置：
        // - CSS 命名颜色："red"
        // - RGB 十六进制："#rgb"、"#rgba"、"#rrggbb"、"#rrggbbaa"
        // - 类 CSS 表示法："rgb(255, 127, 0)"，以及 rgba()、hsl() 等几种其他形式。

        // 聚焦框在当前活动显示器上的颜色。
        active-color "#f4b8e4"

        // 聚焦框在非活动显示器上的颜色。
        //
        // 聚焦框只绘制在活动窗口周围，因此你只能在其余显示器上看到 inactive-color 的效果。
        inactive-color "#e78284"

        // 你也可以使用渐变色。渐变色优先于纯色。
        // 渐变色的渲染方式与 CSS linear-gradient(angle, from, to) 相同。
        // 角度与 linear-gradient 中相同，且为可选参数，默认为 180（从顶部到底部）。
        // 你可以使用任何 Web 上的 CSS linear-gradient 工具来设置它们。
        // 也支持更改色彩空间，更多信息请查阅 Wiki。
        //
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45

        // 你也可以让渐变色相对于整个工作区视图着色，而非仅相对于窗口本身。
        // 通过设置 relative-to="workspace-view" 来实现。
        //
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 你也可以添加边框。它与聚焦框类似，但始终可见。
    border {
        // 这些设置与聚焦框相同。
        // 如果启用了边框，你可能希望禁用聚焦框。
        off

        width 4
        active-color "#ffc87f"
        inactive-color "#505050"

        // 吸引你注意的窗口周围的边框颜色。
        urgent-color "#9b0000"

        // 渐变可以使用几种不同的插值色彩空间。
        // 例如，这是一个通过 in="oklch longer hue" 实现的柔和彩虹渐变。
        //
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"

        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 你可以为窗口启用阴影。
    shadow {
        // 取消下一行的注释以启用阴影。
        // on

        // 默认情况下，阴影仅绘制在窗口周围，而不是其背后。
        // 取消此设置的注释可使阴影绘制在窗口背后。
        //
        // 请注意，niri 无法得知 CSD 窗口的圆角半径。
        // 它必须假设窗口具有方形边角，这会导致
        // CSD 圆角内侧出现阴影瑕疵。此设置可修复这些瑕疵。
        //
        // 不过，你也可以设置 prefer-no-csd 和/或 geometry-corner-radius。
        // 这样 niri 就能知道圆角半径并正确绘制阴影，
        // 而无需在窗口背后绘制。这些设置还会移除窗口自身绘制的客户端阴影（如果有的话）。
        //
        // draw-behind-window true

        // 你可以更改阴影的外观。下面的值以逻辑像素为单位，
        // 与 CSS box-shadow 属性一致。

        // softness 控制阴影的模糊半径。
        softness 30

        // spread 扩展阴影的范围。
        spread 5

        // offset 相对于窗口移动阴影。
        offset x=0 y=5

        // 你也可以更改阴影的颜色和不透明度。
        color "#0007"
    }

    // strut 会缩小窗口占用的区域，类似于 layer-shell 面板。
    // 你可以将它们看作一种外层间隙。它们以逻辑像素为单位。
    // 左右 strut 会使旁边的下一个窗口始终可见。
    // 上下 strut 会在 layer-shell 面板和常规间隙之外再添加一层外侧间隙。
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// 添加类似下面的行可在启动时派生进程。
// 请注意，将 niri 作为 session 运行支持 xdg-desktop-autostart，
// 使用它可能会更方便。
// 下面的 binds 节中包含更多 spawn 示例。

// 这一行启动 waybar，一个常用的 Wayland 合成器状态栏。
spawn-at-startup "waybar"

// 我的自动启动项
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" //询问管理员权限
spawn-at-startup "mako" //通知
spawn-at-startup "fcitx5" //输入法
spawn-at-startup "~/.config/swayidle/swayidle.sh" //熄屏
spawn-sh-at-startup "wl-paste --watch cliphist store" //cliphist剪切板

// 壁纸设置
spawn-at-startup "awww-daemon" "-n" "normal"  //工作区壁纸
spawn-at-startup "awww-daemon" "-n" "blur"    //overview壁纸
layer-rule {
    match namespace="^awww-daemonblur$"
    place-within-backdrop true
}

// 电源
layer-rule {
    match namespace="^wleave$"
    opacity 0.9
    shadow {
        softness 30
    }
    background-effect {
        blur true
    }
}



// 要运行 shell 命令（支持变量、管道等），请使用 spawn-sh-at-startup：
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // 取消此行注释可禁用启动时的"重要快捷键"弹窗。
    skip-at-startup
}

// 取消此行注释可让客户端在可能的情况下省略其客户端装饰。
// 如果客户端明确请求 CSD，则该请求会被尊重。
// 此外，客户端会被告知它们是平铺的，从而移除一些客户端的圆角。
// 此选项还会修复某些半透明窗口背后绘制边框/聚焦框的问题。
// 启用或禁用此选项后，你需要重新启动应用程序以使其生效。
prefer-no-csd

// 你可以更改截图的保存路径。
// 开头的 ~ 将被扩展为主目录。
// 路径使用 strftime(3) 进行格式化，以便为你提供截图的日期和时间。
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 你也可以将其设置为 null 以禁用将截图保存到磁盘。
// screenshot-path null

// 动画设置。
// Wiki 中介绍了如何配置各个动画：
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
    // 取消注释以关闭所有动画。
    // off

    // 通过此因子减慢所有动画。低于 1 的值则会加快动画。
    // slowdown 3.0
}

// 窗口规则允许你调整单个窗口的行为。
// 在 Wiki 中查看更多信息：
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// 通过将 default-column-width 设为空来规避 WezTerm 初次配置时的 bug。
window-rule {
    // 这个正则表达式被故意做得尽可能具体，
    // 因为这是默认配置，我们不希望出现误匹配。
    // 如果你愿意，只用 app-id="wezterm" 也行。
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// 默认将 Firefox 的画中画播放器作为浮动窗口打开。
window-rule {
    // 此 app-id 正则表达式对以下两者都适用：
    // - 主机版 Firefox（app-id 为 "firefox"）
    // - Flatpak 版 Firefox（app-id 为 "org.mozilla.firefox"）
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// 示例：阻止两个密码管理器出现在截屏中。
// （此示例规则用前导 "/-" 注释掉了。）
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // 如果你希望它们在第三方截图工具中可见，请改用此设置。
    // block-out-from "screencast"
}

// 示例：为所有窗口启用圆角。
// （此示例规则用前导 "/-" 注释掉了。）
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

binds {
    // 按键由用 + 号连接修饰键组成，末尾是一个 XKB 按键名。
    // 若要查找特定按键的 XKB 名称，你可以使用类似 wev 的程序。
    //
    // "Mod" 是一个特殊的修饰键：在 TTY 上运行时等于 Super，
    // 在作为 winit 窗口运行时等于 Alt。
    //
    // 你在这里绑定的大多数操作也可以通过 `niri msg action do-something` 以编程方式调用。

    // Mod-Shift-/，通常与 Mod-? 相同，
    // 用于显示重要快捷键的列表。
    Mod+Shift+Slash { show-hotkey-overlay; }

    // 我的快捷键
    Mod+E     { spawn "nautilus"; } //打开文件管理器
    Mod+Alt+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu --lines=15 --width=50 | cliphist decode | wl-copy"; } //打开剪切板

    // 运行程序的建议绑定：终端、应用启动器、屏幕锁。
    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }

    // 使用 spawn-sh 来运行 shell 命令。如果你需要使用管道、多条命令等，请使用此方式。
    // 注意：整个命令作为单个参数传递。它会被原样传递给 `sh -c`。
    // 例如，这是一个用于切换屏幕阅读器（orca）的标准绑定。
    // Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // PipeWire 与 WirePlumber 的示例音量键映射。
    // allow-when-locked=true 属性使它们在会话锁定时也能使用。
    // 使用 spawn-sh 可以将多个参数与命令一起传递。
    // "-l 1.0" 将音量限制在 100%。
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 使用 playerctl 的示例媒体键映射。
    // 这适用于任何支持 MPRIS 的媒体播放器。
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // brightnessctl 的示例亮度键映射。
    // 你也可以使用常规 spawn 配合多个参数（避免通过 "sh"），
    // 但你需要手动将每个参数放在单独的 "" 引号中。
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // 打开/关闭概览：工作区与窗口的缩放视图。
    // 你也可以将鼠标移入左上角的热角，
    // 或者在触摸板上做四指上滑。
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // 备选命令，在到达列中第一个或最后一个窗口时跨工作区移动。
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // 此外，还有一些命令可以仅移动单个窗口：
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // 你也可以将整个工作区移动到另一台显示器：
    // Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    // ...

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // 此外，还有一些命令可以仅移动单个窗口：
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // 你可以使用以下语法绑定鼠标滚轮滚动刻度。
    // 这些绑定会根据 natural-scroll 设置改变方向。
    //
    // 为了避免在各个工作区之间快速滚动，你可以使用
    // cooldown-ms 属性。该绑定将被限制为按此值的频率触发。
    // 你可以为任何绑定设置冷却时间，但最常用于滚轮。
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // 通常在应用程序中使用 Shift 上下滚动会产生水平滚动效果；
    // 以下绑定可复现这种行为。
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // 类似地，你也可以绑定触摸板滚动"刻度"。
    // 触摸板滚动是连续的，因此对于这些绑定，它会被拆分为
    // 离散的间隔。
    // 这些绑定也会受触摸板 natural-scroll 的影响，因此这些
    // 示例绑定是"反向"的，因为我们默认对触摸板启用了 natural-scroll。
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // 你可以通过索引引用工作区。但请注意，
    // niri 是一个动态工作区系统，因此这些命令只能算是
    // "尽力而为"。如果引用的工作区索引大于
    // 当前工作区数量，它将改为引用最底部那个（空的）工作区。
    //
    // 例如，如果有 2 个工作区 + 1 个空的，那么索引 3、4、5 等
    // 都会引用第 3 个工作区。
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // 此外，还有一些命令可以仅移动单个窗口：
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // 在当前和上一个工作区之间切换焦点。
    // Mod+Tab { focus-workspace-previous; }

    // 以下绑定将聚焦的窗口移入或移出一个列。
    // 如果窗口是单独的，它们会将其合并到旁边的列中。
    // 如果窗口已在列中，它们会将其移出。
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // 从右侧将一个窗口合并到聚焦列的底部。
    Mod+Comma  { consume-window-into-column; }
    // 将底部的窗口从聚焦列移出到右侧。
    Mod+Period { expel-window-from-column; }

    // 在 preset-column-widths 中循环切换宽度。
    Mod+R { switch-preset-column-width; }
    // 也可以反向循环切换预设值。
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // maximize-column 会在窗口周围保留间隙和边框，
    // 而 maximize-window-to-edges 不会：窗口会扩展到屏幕边缘。
    // 此绑定对应于普通的窗口最大化操作，
    // 例如双击标题栏。
    Mod+M { maximize-window-to-edges; }

    // 将聚焦的列扩展到未被其他完全可见列占用的空间。
    // 使该列"填满剩余空间"。
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // 将屏幕上所有完全可见的列居中。
    Mod+Ctrl+C { center-visible-columns; }

    // 更精细的宽度调整。
    // 此命令还可以：
    // * 以像素设置宽度："1000"
    // * 以像素调整宽度："-5" 或 "+5"
    // * 将宽度设置为屏幕宽度的百分比："25%"
    // * 按屏幕宽度的百分比调整宽度："-10%" 或 "+10%"
    // 像素大小使用逻辑像素（即缩放后像素）。例如在 scale 2.0 的输出上，
    // set-column-width "100" 将使该列占据 200 个物理屏幕像素。
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // 在与其他窗口同一列时进行更精细的高度调整。
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 在浮动布局和平铺布局之间移动聚焦的窗口。
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // 切换标签式列显示模式。
    // 此列中的窗口将显示为垂直标签，
    // 而不是堆叠在彼此之上。
    Mod+W { toggle-column-tabbed-display; }

    // 切换布局的操作。
    // 注意：如果取消这些注释，请确保你*没有*在
    // 上面的 xkb options 中配置匹配相同的布局切换快捷键。
    // 同一个快捷键同时启用两者会破坏切换功能，
    // 因为按下快捷键时会切换两次（xkb 一次，niri 一次）。
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 诸如远程桌面客户端和软件 KVM 切换器之类的应用程序可能会
    // 请求 niri 停止处理此处定义的键盘快捷键，
    // 以便它们可以（例如）将按键原样转发到远程机器。
    // 最好绑定一个"逃生出口"来切换该抑制器，
    // 以免某个有 bug 的应用程序劫持你的会话。
    //
    // allow-inhibiting=false 属性也可以应用于其他绑定，
    // 这能确保即使在抑制器激活时 niri 也始终处理它们。
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // quit 操作会显示一个确认对话框，以避免意外退出。
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // 关闭显示器。要重新打开，执行任何输入操作即可，
    // 例如移动鼠标或按任意其他键。
    Mod+Shift+P { power-off-monitors; }
}
